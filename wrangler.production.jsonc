// Replace resource names/IDs before deployment. Never copy local .wrangler state.
{
  "name": "loka-portrait",
  "main": "./dist/server/index.js",
  "no_bundle": true,
  "rules": [{"type":"ESModule","globs":["**/*.js","**/*.mjs"]}],
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "./dist/client", "binding": "ASSETS"},
  "d1_databases": [{"binding":"DB","database_name":"loka-production","database_id":"REPLACE_WITH_PRODUCTION_D1_ID","migrations_dir":"drizzle"}],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"loka-production-photos"}],
  "triggers": {"crons":["* * * * *"]},
  "observability": {"enabled":true},
  "vars": {"AI_MODE":"demo","ALLOW_DEMO_SAMPLES":"false","EVENT_JOB_LIMIT":"200","MAX_QUEUED_JOBS":"30","UPLOADS_PER_HOUR":"20","RETENTION_DAYS":"7"}
}
