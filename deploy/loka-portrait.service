[Unit]
Description=Loka Portrait
After=network.target

[Service]
Type=simple
User=loka-portrait
Group=loka-portrait
WorkingDirectory=/srv/loka-portrait/current
Environment=NODE_ENV=production
Environment=LOKA_DATA_DIR=/var/lib/loka-portrait
Environment=PORT=8791
Environment=VINEXT_TRUSTED_HOSTS=potrait.takaloka.in
ExecStart=/usr/bin/node scripts/start-vps.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/loka-portrait
MemoryMax=2G
CPUQuota=200%

[Install]
WantedBy=multi-user.target
